# Salin file ini menjadi .env lalu sesuaikan nilainya.
# JANGAN pernah meng-commit .env berisi kredensial asli.

# --- Database (PostgreSQL) ---
# Produksi/DB sungguhan:
DATABASE_URL="postgresql://postgres:password@localhost:5432/mendung_tirta?schema=public"
# Shadow database untuk `prisma migrate dev` (opsional; boleh DB kosong terpisah)
SHADOW_DATABASE_URL="postgresql://postgres:password@localhost:5432/mendung_tirta_shadow?schema=public"

# Alternatif lokal tanpa PostgreSQL terpasang (pengembangan/pengujian):
# jalankan `npm run db:server` lalu pakai baris di bawah ini.
# DATABASE_URL="postgresql://postgres@127.0.0.1:55432/postgres"
# SHADOW_DATABASE_URL="postgresql://postgres@127.0.0.1:55433/postgres"

# --- Aplikasi ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Asisten AI (opsional) ---
# Hanya dibaca di backend; JANGAN pernah memakai prefiks NEXT_PUBLIC_.
# Bila kosong, asisten tetap berjalan dalam mode katalog (fallback tanpa LLM).
# Provider apa pun yang OpenAI-compatible bisa dipakai, misalnya NVIDIA NIM:
# AI_API_KEY="nvapi-XXXX"                                # key dari build.nvidia.com
# AI_BASE_URL="https://integrate.api.nvidia.com/v1"      # endpoint NVIDIA NIM
# AI_MODEL="openai/gpt-oss-20b"                          # model yang diaktifkan di akun
# Atau OpenAI langsung:
# AI_API_KEY="sk-..."
# AI_BASE_URL="https://api.openai.com/v1"
# AI_MODEL="gpt-4o-mini"
